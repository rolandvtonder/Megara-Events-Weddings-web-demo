# Public URL of the live site (used for sitemap, Open Graph and canonical links).
NEXT_PUBLIC_SITE_URL=https://megara.co.za

# Optional: a form endpoint (e.g. Formspree, Basin or Getform) that accepts JSON POSTs.
# When unset, the enquiry and resource forms fall back to opening the visitor's email app.
NEXT_PUBLIC_FORM_ENDPOINT=
